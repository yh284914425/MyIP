# DNS Leak Detection Tool Environment Variables

# Domain configuration (必须配置)
DOMAIN_NAME=checkdnsleak.com

# Server IP addresses (必须配置)
VPS_IPV4=23.95.215.125
VPS_IPV6=2001:db8::1

# Redis configuration (Docker环境下使用默认值)
REDIS_HOST=redis
REDIS_PORT=6379

# 开发环境 Redis 配置（本地开发时）
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Application environment
NODE_ENV=production

# Optional: Analytics
VITE_GOOGLE_ANALYTICS_ID=your-analytics-id

# Optional: IPInfo API token (for enhanced geolocation)
IPINFO_API_TOKEN=your-ipinfo-token